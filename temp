Upload_to_dockerhub:
  runs-on: ubuntu-latest
  needs: Change_Version
  env:
    REGISTRY_IMAGE: "${{ vars.DOCKERHUB_USERNAME }}/java_app"
    NEW_VERSION: "${{ needs.Change_Version.outputs.new_version }}"
  steps:
    - name: download artifacrt
      uses: actions/download-artifact@v8.0.1
      with:
        name: java-docker-image
        path: /tmp
    - name: Docker Setup
      uses: docker/setup-docker-action@v5.4.0
    - name: untar image
      run: docker load -i /tmp/java_app.tar
    - name: Docker Login
      uses: docker/login-action@v4.6.0
      with:
        username: ${{ vars.DOCKERHUB_USERNAME }}
        password: ${{ secrets.DOCKERHUB_TOKEN }}
    - name: tag and push image
      run: |
        docker tag java_app:latest $REGISTRY_IMAGE:$NEW_VERSION
        docker push $REGISTRY_IMAGE:$NEW_VERSION
        docker tag java_app:latest $REGISTRY_IMAGE:latest
        docker push $REGISTRY_IMAGE:latest
